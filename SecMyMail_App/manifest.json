{
    "manifest_version": 2,
    "name": "SecMyMail",
    "version": "1.0",
    "description": "Greffon Thunderbird pour améliorer la sécurité en identifiant les messages suspects et les courriels provenant de domaines non autorisés.",
    "applications": {
    "gecko": {
        "id": "secmymail@example.com",
        "strict_min_version": "78.0"
    }
    },
    "permissions": [
        "messagesRead",               
        "storage",                   
        "filters",                    
        "webRequest",               
        "activeTab",                  
        "compose"                     
    ],
    "background": {
        "scripts": ["background/background.js"]  
    },
    "messages": {
    "sender": {
        "default_popup": "views/popup/popup.html",
        "default_icon": {
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    }
    },
    "options_ui": {
        "page": "views/balise/balise.html",        
        "open_in_tab": true
    },
    "browser_action": {
        "default_icon": "icons/icon.png",
        "default_popup": "popup.html",   
        "default_title": "SecMyMail"  
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        "icons/icon-48.png",
        "icons/icon-128.png"
    ],
    "optional_permissions": [
        "history",  
        "tabs"
    ]
}